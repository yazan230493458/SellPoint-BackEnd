# Active Saudi payment provider (moyasar is implemented; others are architecture-ready)
PAYMENT_PROVIDER=moyasar

# Moyasar (https://moyasar.com) — use test keys first
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
MOYASAR_WEBHOOK_SECRET=replace_with_dashboard_webhook_secret
MOYASAR_API_BASE=https://api.moyasar.com/v1
# Set true only after switching to live keys
MOYASAR_LIVE_MODE=false

# Public backend URL used for Moyasar invoice callback_url
PUBLIC_API_URL=https://api.your-domain.com

# Already used by SellPoint — required for success/back redirects
FRONTEND_URL=https://your-domain.com

# Future providers (not implemented yet — keep unset)
# HYPERPAY_ENTITY_ID=
# HYPERPAY_ACCESS_TOKEN=
# PAYTABS_PROFILE_ID=
# PAYTABS_SERVER_KEY=
# TAP_SECRET_KEY=
# PAYLINK_API_ID=
# PAYLINK_SECRET_KEY=
# AMAZON_PS_MERCHANT_IDENTIFIER=
# AMAZON_PS_ACCESS_CODE=
# AMAZON_PS_SHA_REQUEST_PHRASE=
