,null,null,null,null,null,null],"ur":["غیر مجاز","ممنوع","صارف نہیں ملا","غلط اندراج","اینڈ پوائنٹ نہیں ملا","اندرونی سرور خرابی","ریکارڈ پہلے سے موجود ہے","ریکارڈ نہیں ملا","اشتہار نہیں ملا","تبصرہ نہیں ملا","نیا تبصرہ","رپورٹ اپ ڈیٹ ہو گئی",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"اشتہاری سرگرمی",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"اگر اس ای میل کے ساتھ کوئی اکاؤنٹ موجود ہے اور ڈیلیوری کامیاب ہو جاتی ہے، تو پاس ورڈ دوبارہ ترتیب دینے کا پیغام جلد ہی آئے گا۔","پاس ورڈ ریکوری ای میل کنفیگر نہیں ہے۔",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"fa":["غیرمجاز","ممنوع","کاربر یافت نشد","ورودی نامعتبر","نقطه پایانی یافت نشد","خطای داخلی سرور","رکورد از قبل وجود دارد","رکورد یافت نشد","آگهی یافت نشد","نظر یافت نشد","نظر جدید","گزارش به‌روزرسانی شد",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"فعالیت تبلیغاتی",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"اگر حسابی با آن ایمیل وجود داشته باشد و تحویل با موفقیت انجام شود، پیام بازنشانی رمز عبور به زودی دریافت خواهد شد.","ایمیل بازیابی رمز عبور پیکربندی نشده است.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"he":["אין הרשאה","אסור","המשתמש לא נמצא","קלט לא תקין","הנקודה לא נמצאה","שגיאת שרת פנימית","הרשומה כבר קיימת","הרשומה לא נמצאה","המודעה לא נמצאה","התגובה לא נמצאה","תגובה חדשה","הדיווח עודכן",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"פעילות מודעות",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"אם קיים חשבון עם האימייל הזה והמשלוח יצליח, הודעת איפוס תגיע בקרוב.","אימייל לשחזור סיסמה לא מוגדר.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"id":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Aktivitas periklanan",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Jika akun dengan email tersebut ada dan pengiriman berhasil, pesan pengaturan ulang kata sandi akan segera tiba.","Email pemulihan kata sandi tidak dikonfigurasi.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"ms":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Aktiviti pengiklanan",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Jika akaun dengan e-mel itu wujud dan penghantaran berjaya, mesej tetapan semula kata laluan akan tiba tidak lama lagi.","E-mel pemulihan kata laluan tidak dikonfigurasikan.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"bn":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"বিজ্ঞাপন কার্যকলাপ",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"যদি সেই ইমেল সহ একটি অ্যাকাউন্ট বিদ্যমান থাকে এবং বিতরণ সফল হয়, একটি পাসওয়ার্ড রিসেট বার্তা শীঘ্রই আসবে৷","পাসওয়ার্ড পুনরুদ্ধার ইমেল কনফিগার করা নেই.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"th":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"กิจกรรมประกาศ",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"หากมีบัญชีที่ใช้อีเมลดังกล่าวและจัดส่งได้สำเร็จ ข้อความรีเซ็ตรหัสผ่านจะมาถึงในไม่ช้า","ไม่ได้กำหนดค่าอีเมลกู้คืนรหัสผ่าน",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"vi":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Hoạt động quảng cáo",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Nếu tài khoản có email đó tồn tại và gửi thành công, thông báo đặt lại mật khẩu sẽ sớm đến.","Email khôi phục mật khẩu chưa được định cấu hình.",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"pl":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"Aktywność 